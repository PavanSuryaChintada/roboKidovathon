# Supabase — RoboKidovation Västerås
# Copy this file to .env and fill in real values. .env is gitignored.

# --- Used by the frontend (Vite exposes only VITE_-prefixed vars to the browser bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side / admin only — NOT prefixed with VITE_, so Vite will never bundle these into client JS ---
SUPABASE_PROJECT_ID=
SUPABASE_PROJECT_REGION=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_POOLER_URL=
SUPABASE_ACCESS_TOKEN=
